{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "xpeed-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--max-http-header-size=262144",
        "node_modules/vite/bin/vite.js"
      ],
      "port": 5000
    },
    {
      "name": "xpeed-screens",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "--config",
        "vite.harness.config.ts"
      ],
      "port": 5010
    },
    {
      "name": "xpeed-screens-virtual",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "--config",
        "vite.harness.config.ts",
        "--port",
        "5011",
        "--strictPort"
      ],
      "env": {
        "VITE_ENABLE_VIRTUAL": "true"
      },
      "port": 5011
    },
    {
      "name": "xpeed-screens-admin",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "--config",
        "vite.harness.config.ts",
        "--port",
        "5013",
        "--strictPort"
      ],
      "env": {
        "VITE_ENABLE_VIRTUAL": "true",
        "VITE_HARNESS_ADMIN": "true"
      },
      "port": 5013
    },
    {
      "name": "xpeed-screens-new-driver",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "--config",
        "vite.harness.config.ts",
        "--port",
        "5012",
        "--strictPort"
      ],
      "env": {
        "VITE_ENABLE_VIRTUAL": "true",
        "HARNESS_NEW_DRIVER": "1"
      },
      "port": 5012
    },
    {
      "name": "rc-pilot",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "-d",
        "rc-car/pilot"
      ],
      "port": 8090
    },
    {
      "name": "xpeed-build-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "xpeed-sim-panel-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5180",
        "--bind",
        "127.0.0.1",
        "--directory",
        "xpeed-sim/target/panel-preview"
      ],
      "port": 5180
    }
  ]
}