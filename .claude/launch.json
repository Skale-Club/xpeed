{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "xpeed-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--max-http-header-size=262144",
        "node_modules/vite/bin/vite.js"
      ],
      "port": 5000
    },
    {
      "name": "xpeed-screens",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "--config",
        "vite.harness.config.ts"
      ],
      "port": 5010
    },
    {
      "name": "xpeed-build-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}