# Supabase Configuration
VITE_SUPABASE_PROJECT_ID=your_project_id_here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
VITE_APP_URL=https://your-app-domain.vercel.app
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Login: Google Cloud Identity Platform, in the same project as Xpot.
# All VITE_FIREBASE values below are public web app configuration, not secrets.
VITE_FIREBASE_PROJECT_ID=skaleclub
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=skaleclub.firebaseapp.com
VITE_GOOGLE_CLIENT_ID=your_xpeed_oauth_web_client_id
# Optional when only Authentication is used:
VITE_FIREBASE_APP_ID=your_firebase_web_app_id

# Legacy maintenance scripts only; never used by the application login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_here

# Virtual (racing games) mode. Off unless set to "true". Production turns it on in the Dockerfile (since 2026-11-13).
# VITE_ENABLE_VIRTUAL=true

# --- Own database (leaving Supabase) -------------------------------------
# Production (Coolify): the app's own PostgreSQL. The server migrates it at start.
# Development: the Supabase project's Postgres (Settings > Database > Connection string).
DATABASE_URL=
DATABASE_SSL=
# Development only: read-only URL of the production database (through an SSH tunnel or
# Tailscale). `npm run dev` copies anonymized data from it into DATABASE_URL.
PROD_DATABASE_URL=
# Accounts that stay recognizable in the development copy, so you can sign in and see your own data.
DEV_KEEP_EMAILS=
DEV_KEEP_PHONES=
# DEV_SYNC=off skips the sync; `npm run dev:fast` starts Vite without it.
# true = the app reads and writes tables through this app's own server (/api/db) instead of Supabase.
# Needs DATABASE_URL on the server. In `npm run dev` Vite serves /api/db itself against DATABASE_URL.
VITE_DATA_API=
