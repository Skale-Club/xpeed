<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Notification.Trip.Title" parent="TextAppearance.Compat.Notification.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Notification.Trip.Caption" parent="TextAppearance.Compat.Notification.Line2">
        <item name="android:textSize">11sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Notification.Trip.Value" parent="TextAppearance.Compat.Notification.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">12sp</item>
        <item name="android:autoSizeMaxTextSize">28sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>
    <style name="Notification.Trip.CompactValue" parent="Notification.Trip.Value">
        <item name="android:textSize">18sp</item>
        <item name="android:autoSizeMinTextSize">10sp</item>
        <item name="android:autoSizeMaxTextSize">18sp</item>
    </style>
</resources>
