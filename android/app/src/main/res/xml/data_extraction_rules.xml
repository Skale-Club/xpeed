<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of the app is copied to the cloud backup or to a new phone: the web
  layer's storage holds the sign-in (refresh token) and copies of trips, which
  must not travel with a backup. Android 12+ reads this file; allowBackup="false"
  covers older versions.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
